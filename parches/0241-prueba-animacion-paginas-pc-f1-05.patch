+                 p = e.find("if S.anim and S.anim.pagina then return S.cambiar() end", p + 1))
+                ++veces;
+            t.Equals(veces, static_cast<size_t>(3), "X, Triangle and the arrows during the first half only finish the swap");
+            t.IsTrue(tiene("S.anim = {inicio = os.time(), cuadros = 0, pagina = {n, cursor}}"), "abrir starts it");
+            t.IsTrue(tiene("if n == 0 then\n      S.cambiar()\n      S.anim = nil"),
+                     "page 0 after an error: at once, without the transition");

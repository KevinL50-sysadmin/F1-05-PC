+        tc.Run("PC pages host: a page shown in the same node plays the game's screen transition (T8b)", [](TestCase &t)
+        {
+            const std::string e = f1::opciones_juego::kExtensionPantalla;
+            auto tiene = [&](const char *trozo) { return e.find(trozo) != std::string::npos; };
+            t.IsTrue(tiene("S.dibujar = M.onRender\n  M.onRender = function(self)"),
+                     "each frame through Menu.onRender (the pause's onCustomRender calls it too)");
+            t.IsTrue(tiene("local bien, e = pcall(S.paso)"), "a frame of the transition under pcall");
+            t.IsTrue(tiene("local f = math.max((os.time() - a.inicio) / S.duracion, a.cuadros / (60 * S.duracion))"),
+                     "progress by the game's clock (os.time, seconds), by frames if the clock stands");
+            t.IsTrue(tiene("M:onTransition(math.max(0, (0.5 - f) * 2))\n      draw.alphafade(1 - f)"),
+                     "first half: the old rows leave as DisplaySettings' onTransitionOut moves them");
+            t.IsTrue(tiene("M:onTransition(math.max(0, (f - 0.5) * 2))\n      draw.alphafade(f)"),
+                     "second half: the new rows come in as its onTransitionIn moves them");
+            t.IsTrue(tiene("if f >= 0.5 then S.cambiar() end"), "the page is swapped halfway");
+            t.IsTrue(tiene("S.anim = nil\n      M:onTransition(1)\n      draw.alphafade(1)"),
+                     "the end: rows in place, nothing faded");
+            t.IsTrue(tiene("S.duracion = 0.5"), "the engine's 0.5 s until a transition is seen");
+            t.IsTrue(tiene("if total and total > 0 then S.duracion = total end"),
+                     "then the engine's own duration (onTransitionIn's total)");
+            t.IsTrue(tiene("onTransitionOut = function(t, total)\n      S.anim = nil"),
+                     "the engine's transitions cancel ours (they move the rows themselves)");
+            t.IsTrue(tiene("if not S.cambiando and not S.rehaciendo then\n      S.anim = nil"),
+                     "leaving the node cancels it; our own swap and a rebuild keep it");
+            size_t veces = 0;

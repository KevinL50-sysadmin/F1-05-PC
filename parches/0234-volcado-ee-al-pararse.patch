+// Patch 0234: when the vigilante sees the screen or the EE stopped (rising edge, checked once per second), dump the
+// guest EE threads (status, wait reason, pc/ra), the semaphores and event flags with waiters and the last SIF RPC
+// events, to find which guest thread waits on what (odd/tasks/issue-1-cabeza.md T2).
+static const char *EeThreadStatusName0234(EeThreadStatus status)
+{
+    switch (status)
+    {
+    case EeThreadStatus::Running: return "Running";
+    case EeThreadStatus::Ready: return "Ready";
+    case EeThreadStatus::Waiting: return "Waiting";
+    case EeThreadStatus::WaitingSuspended: return "WaitingSuspended";
+    case EeThreadStatus::Suspended: return "Suspended";
+    case EeThreadStatus::Dormant: return "Dormant";
+    }
+    return "?";
+}
+
+static const char *EeWaitReasonName0234(EeWaitReason reason)
+{
+    switch (reason)
+    {
+    case EeWaitReason::None: return "None";
+    case EeWaitReason::Sleep: return "Sleep";
+    case EeWaitReason::Semaphore: return "Semaphore";
+    case EeWaitReason::EventFlag: return "EventFlag";
+    case EeWaitReason::VSync: return "VSync";
+    case EeWaitReason::External: return "External";
+    case EeWaitReason::Mpeg: return "Mpeg";
+    }
+    return "?";
+}
+
+static void DumpEeStateOnStall(PS2Runtime &rt)
+{
+    // Patch 0234: on by default (players' logs are how a hang report gets diagnosed); PS2X_VOLCADO_EE=0 turns it off.
+    static const bool s_enabled = []()
+    {
+        const char *value = std::getenv("PS2X_VOLCADO_EE");
+        return value == nullptr || value[0] != '0';
+    }();
+    if (!s_enabled)
+        return;
+    static auto lastCheck = std::chrono::steady_clock::time_point{};
+    static bool dumped = false;
+    const auto now = std::chrono::steady_clock::now();
+    if (now - lastCheck < std::chrono::seconds(1))
+        return;
+    lastCheck = now;
+    const bool stalled = ps2x::vigilante::latidoParado("pantalla") || ps2x::vigilante::latidoParado("EE");
+    if (!stalled)
+    {
+        dumped = false;
+        return;
+    }
+    if (dumped)
+        return;
+    dumped = true;
+
+    const EeKernelSnapshot snap = rt.eeScheduler().snapshot();
+    char line[512];
+    std::snprintf(line, sizeof(line), "[vigilante:ee] seq=%llu eeCycle=%llu running=%d threads=%zu semas=%zu flags=%zu",
+                  static_cast<unsigned long long>(snap.sequence), static_cast<unsigned long long>(snap.eeCycle),
+                  snap.runningThreadId, snap.threads.size(), snap.semaphores.size(), snap.eventFlags.size());
+    std::cout << line << '\n';
+    for (const EeThreadSnapshot &t : snap.threads)
+    {
+        std::snprintf(line, sizeof(line),
+                      "[vigilante:ee] thread id=%d status=%s wait=%s waitId=%d pc=0x%08X ra=0x%08X sp=0x%08X "
+                      "entry=0x%08X prio=%d wakeup=%u suspend=%d",
+                      t.id, EeThreadStatusName0234(t.status), EeWaitReasonName0234(t.waitReason), t.waitId, t.pc, t.ra,
+                      t.sp, t.entry, t.currentPriority, t.wakeupCount, t.suspendCount);
+        std::cout << line << '\n';
+    }
+    for (const EeSemaphoreSnapshot &s : snap.semaphores)
+    {
+        if (s.waiters == 0u && s.count != 0)
+            continue;
+        std::snprintf(line, sizeof(line), "[vigilante:ee] sema id=%d count=%d max=%d waiters=%u", s.id, s.count,
+                      s.maxCount, s.waiters);
+        std::cout << line << '\n';
+    }
+    for (const EeEventFlagSnapshot &f : snap.eventFlags)
+    {
+        if (f.waiters == 0u)
+            continue;
+        std::snprintf(line, sizeof(line), "[vigilante:ee] evflag id=%d bits=0x%08X attr=0x%X waiters=%u", f.id, f.bits,
+                      f.attr, f.waiters);
+        std::cout << line << '\n';
+    }
+
+    // Patch 0234: this runs on the window's loop, so never wait for the RPC lock (its holder may be the stalled part).
+    std::vector<SifRpcDebugEvent> events;
+    {
+        std::unique_lock<std::mutex> lock(g_rpc_mutex, std::try_to_lock);
+        if (!lock.owns_lock())
+        {
+            std::cout << "[vigilante:ee] rpc: historial ocupado, omitido" << std::endl;
+            return;
+        }
+        events.reserve(kSifRpcDebugHistoryCount);
+        for (size_t i = 0; i < kSifRpcDebugHistoryCount; ++i)
+        {
+            if (g_sif_rpc_debug_history[i].seq != 0u)
+                events.push_back(g_sif_rpc_debug_history[i]);
+        }
+    }
+    std::sort(events.begin(), events.end(),
+              [](const SifRpcDebugEvent &a, const SifRpcDebugEvent &b) { return a.seq < b.seq; });
+    const size_t first = events.size() > 24u ? events.size() - 24u : 0u;
+    for (size_t i = first; i < events.size(); ++i)
+    {
+        const SifRpcDebugEvent &e = events[i];
+        std::snprintf(line, sizeof(line),
+                      "[vigilante:ee] rpc seq=%llu op=%s pc=0x%08X ra=0x%08X thread=%u sid=0x%08X rpcNum=%u mode=0x%X "
+                      "sema=%u flags=0x%X send=%u recv=%u",
+                      static_cast<unsigned long long>(e.seq), e.op ? e.op : "", e.pc, e.ra, e.threadId, e.sid,
+                      e.rpcNum, e.mode, e.semaId, e.flags, e.sendSize, e.recvSize);
+        std::cout << line << '\n';
+    }
+    std::cout << std::flush;
+}
+

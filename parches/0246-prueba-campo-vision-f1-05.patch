diff --git a/ps2xTest/src/ps2_f1_campo_vision_tests.cpp b/ps2xTest/src/ps2_f1_campo_vision_tests.cpp
new file mode 100644
index 0000000..657383f
--- /dev/null
+++ b/ps2xTest/src/ps2_f1_campo_vision_tests.cpp
@@ -0,0 +1,79 @@
+#include "MiniTest.h"
+#include "../../../../src/f1_campo_vision.h" // F1 05's src/, the header its f1_overrides.cpp uses
+
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <string>
+
+// odd/tasks/opciones-pc.md T10 (S6): the field of view of F1 05's race cameras. func_2C55B0(f12 = half angle, f13, f14,
+// a0 = camera, a1, a2) is called by the race camera method's two kinds (0x1EB768, 0x1EBDE0; returns 0x1EBA24 and
+// 0x1EC45C) and also by the camera's creation (0x111C90) and a fixed scene (0x236008); only the race calls are widened,
+// by settings.ini fov (0 = the game's; 5 to 30 = that percent), at most 1.4 rad, from the game's own angle each frame.
+namespace
+{
+    using namespace f1::campo_vision;
+
+    bool mismosBits(float a, float b)
+    {
+        return std::memcmp(&a, &b, sizeof(a)) == 0;
+    }
+}
+
+void register_ps2_f1_campo_vision_tests()
+{
+    MiniTest::Case("F1CampoVision", [](TestCase &tc)
+    {
+        tc.Run("only the two race camera calls of func_2C55B0 are widened; creation, scenes, menus and TV are not",
+               [](TestCase &t)
+        {
+            t.Equals(kCamaraEnvoltura, 0x002C55B0u, "the hooked wrapper");
+            t.IsTrue(ensanchaRetorno(0x001EBA24u), "0x1EB768's call (race camera, first kind)");
+            t.IsTrue(ensanchaRetorno(0x001EC45Cu), "0x1EBDE0's call (race camera, second kind)");
+            for (const uint32_t otro : {0x00111D58u, 0x00236260u, 0x002C55C8u, 0x00133FF0u, 0x001EEC30u, 0x001EF1B8u,
+                                        0x001EBA1Cu, 0x001EC454u, 0x00000000u, 0xFFFFFFFFu})
+                t.IsFalse(ensanchaRetorno(otro), "not widened: return 0x" + std::to_string(otro));
+            t.Equals(std::string(nombreLlamador(0x001EBA24u)), std::string("carrera 0x1EB768"), "names for the log");
+            t.Equals(std::string(nombreLlamador(0x001EC45Cu)), std::string("carrera 0x1EBDE0"), "the other kind");
+            t.Equals(std::string(nombreLlamador(0x00111D58u)), std::string("creacion 0x111C90"), "the creation");
+            t.Equals(std::string(nombreLlamador(0x00236260u)), std::string("escena 0x236008"), "the fixed scene");
+            t.Equals(std::string(nombreLlamador(0x002C55C8u)), std::string("envoltura 0x2C55B0"),
+                     "func_2C5080 from it");
+            t.Equals(std::string(nombreLlamador(0x00133FF0u)), std::string("menu 0x133F48"), "the menus' camera");
+            t.Equals(std::string(nombreLlamador(0x001EEC30u)), std::string("tv 0x1EE8E8"), "TV camera");
+            t.Equals(std::string(nombreLlamador(0x001EF1B8u)), std::string("tv 0x1EEC70"), "the other TV camera");
+            t.Equals(std::string(nombreLlamador(0x00123456u)), std::string("otro"), "anything else");
+        });
+
+        tc.Run("a race camera's half angle widened by the percent, at most 1.4 rad; others and 0 % exactly as given",
+               [](TestCase &t)
+        {
+            const uint32_t carrera = 0x001EBA24u, otra = 0x001EC45Cu, escena = 0x00236260u;
+            t.IsTrue(mismosBits(ensancharCamara(carrera, 0.3477390f, 0), 0.3477390f),
+                     "0 %: the game's angle, bit for bit");
+            t.IsTrue(std::fabs(ensancharCamara(carrera, 0.5f, 10) - 0.55f) < 1e-6f, "+10 %");
+            t.IsTrue(std::fabs(ensancharCamara(otra, 0.5f, 30) - 0.65f) < 1e-6f, "+30 % on the other kind");
+            t.IsTrue(std::fabs(ensancharCamara(carrera, 0.5f, 45) - 0.65f) < 1e-6f, "past 30 %: 30 %");
+            t.Equals(ensancharCamara(carrera, 1.2f, 30), 1.4f, "at most 1.4 rad");
+            t.Equals(ensancharCamara(carrera, 1.5f, 30), 1.5f, "never narrower than the game's");
+            t.Equals(ensancharCamara(carrera, 0.5f, -5), 0.5f, "a negative percent: unchanged");
+            t.IsTrue(std::isnan(ensancharCamara(carrera, std::nanf(""), 30)), "not a number: as it was");
+            t.IsTrue(mismosBits(ensancharCamara(escena, 0.5f, 30), 0.5f), "the fixed scene keeps its angle");
+            t.IsTrue(mismosBits(ensancharCamara(0x00111D58u, 0.2608043f, 30), 0.2608043f), "the creation too");
+            // No accumulation: the game passes its own angle (data + 0x30 * 0.75) every frame and the result only
+            // depends on it.
+            const float primera = ensancharCamara(carrera, 0.4f, 20);
+            t.IsTrue(mismosBits(ensancharCamara(carrera, 0.4f, 20), primera), "the same angle every frame");
+            t.IsTrue(std::fabs(primera - 0.48f) < 1e-6f, "+20 % of the game's, not of the last frame's");
+        });
+
+        tc.Run("PS2X_FOV: only the option's steps 0, 5 ... 30; anything else is 0 (the game's)", [](TestCase &t)
+        {
+            t.Equals(porcentajeTexto(nullptr), 0, "not set");
+            for (const int paso : {0, 5, 10, 15, 20, 25, 30})
+                t.Equals(porcentajeTexto(std::to_string(paso).c_str()), paso, "step " + std::to_string(paso));
+            for (const char *malo : {"", "12", "35", "-5", "abc", "10x", " 10", "100"})
+                t.Equals(porcentajeTexto(malo), 0, std::string("not a step: '") + malo + "'");
+        });
+    });
+}

+    // Patch 0221: a synthetic IRX (base 0x10000) whose start registers and enables a handler for IRQ 0x24 (SPU2 core 0
+    // DMA, channel 4) and starts `starts` (1 or 2) DMAs of 1024 words (2048 cycles each) on channel 4, back to back.
+    // It stores CHCR right after each start at 0x10300/0x10304. The handler counts its calls at 0x10310 and stores the
+    // CHCR it sees at 0x10320 + 4 * call.
+    struct SpuDmaRig
+    {
+        static constexpr uint32_t kChcrAfterStart = 0x10300u;
+        static constexpr uint32_t kHandlerCalls = 0x10310u;
+        static constexpr uint32_t kChcrInHandler = 0x10320u;
+        static constexpr uint32_t kBusy = 1u << 24u;
+
+        iop_test::Host host;
+        ps2x::iop::IopSubsystem iop{host};
+
+        explicit SpuDmaRig(uint32_t starts)
+        {
+            const auto jal = [](uint32_t target) { return 0x0C000000u | ((target >> 2u) & 0x03FFFFFFu); };
+            constexpr uint32_t kRegisterStub = 0x101D4u; // import table at 0x101C0: 5 header words, then the stubs
+            constexpr uint32_t kEnableStub = 0x101DCu;
+            const uint32_t nop = 0u;
+            const uint32_t startDma = 0xAD090008u;  // sw t1, 8(t0): CHCR = start, to SPU2
+            const uint32_t readChcr = 0x8D0A0008u;  // lw t2, 8(t0)
+            iop_test::Irx image;
+            image.words(0x0u, {
+                0x27BDFFE0u, 0xAFBF001Cu,                         // addiu sp, -32; sw ra, 28(sp)
+                0x24040024u, 0x24050001u, 0x3C060001u, 0x34C60200u, // RegisterIntrHandler(0x24, 1, 0x10200, 0)
+                0x00003821u, jal(kRegisterStub), nop,
+                0x24040024u, jal(kEnableStub), nop,               // EnableIntr(0x24)
+                0x3C081F80u, 0x350810C0u,                         // t0 = 0x1F8010C0 (channel 4 MADR)
+                0x3C090001u, 0x35290400u, 0xAD090000u,            // MADR = 0x10400
+                0x3C090040u, 0x35290010u, 0xAD090004u,            // BCR = 64 blocks of 16 words
+                0x3C090100u, 0x35290201u,                         // t1 = 0x01000201 (CHCR start, to SPU2)
+                0x3C0B0001u,                                      // t3 = 0x10000
+                startDma, readChcr, nop, 0xAD6A0300u,             // start; [0x10300] = CHCR
+            });
+            image.words(0x70u, starts > 1u ? std::initializer_list<uint32_t>{startDma, readChcr, nop, 0xAD6A0304u}
+                                           : std::initializer_list<uint32_t>{nop, nop, nop, nop});
+            image.words(0x80u, {0x8FBF001Cu, 0x00001021u, 0x27BD0020u, 0x03E00008u, nop}); // return 0
+            image.words(0x1C0u, {0x41E00000u, 0u, 0x0101u, 0x72746E69u, 0x006E616Du, // "intrman"
+                                 0x03E00008u, 0x24000004u,                          // RegisterIntrHandler
+                                 0x03E00008u, 0x24000006u,                          // EnableIntr
+                                 0u, 0u});
+            image.words(0x200u, {
+                0x3C080001u, 0x8D090310u, nop,                    // t1 = calls
+                0x3C0A1F80u, 0x8D4B10C8u, nop,                    // t3 = CHCR (channel 4)
+                0x00096080u, 0x01886021u, 0xAD8B0320u,            // [0x10320 + 4 * calls] = CHCR
+                0x25290001u, 0xAD090310u,                         // calls + 1
+                0x24020001u, 0x03E00008u, nop,                    // return 1
+            });
+            image.install(host);
+            loaded = iop.loadModuleBuffer(0x1000u).moduleId > 0;
+        }
+
+        [[nodiscard]] uint32_t word(uint32_t address) const
+        {
+            uint32_t value = 0xFFFFFFFFu;
+            (void)iop.readMemory(address, &value, sizeof(value));
+            return value;
+        }
+        void runIopCycles(uint64_t cycles) { iop.runEeCycles(cycles * 8u); }
+
+        bool loaded = false;
+    };
 }
 

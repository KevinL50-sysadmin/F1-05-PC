diff --git a/ps2xTest/src/ps2_f1_letra_tests.cpp b/ps2xTest/src/ps2_f1_letra_tests.cpp
new file mode 100644
index 0000000..0742965
--- /dev/null
+++ b/ps2xTest/src/ps2_f1_letra_tests.cpp
@@ -0,0 +1,102 @@
+#include "MiniTest.h"
+#include "../../../../src/f1_letra.h" // F1 05's src/, the header its f1_overrides.cpp uses
+
+#include <cstring>
+#include <string>
+#include <vector>
+
+// odd/tasks/opciones-pc.md T9 (S6): F1 05's FPS counter in the game's own letter. The .bft reader 0x2D2DE8 opens the
+// file with 0x23FBC8 (a string view: low word the address, high word the length) and reads it through its stream;
+// the bytes it reads, in order, are the file (ps2x::storeGameFontFile).
+namespace
+{
+    constexpr size_t kRam = 0x10000u;
+
+    uint64_t vista(uint32_t direccion, uint32_t largo)
+    {
+        return (uint64_t(largo) << 32) | direccion;
+    }
+}
+
+void register_ps2_f1_letra_tests()
+{
+    MiniTest::Case("F1Letra", [](TestCase &tc)
+    {
+        tc.Run("a .bft by its name, in any case; nothing else", [](TestCase &t)
+        {
+            t.IsTrue(f1::letra::esLetra("Frontend/Fonts/Futurah14Px.bft"), "F1 05's menu letter");
+            t.IsTrue(f1::letra::esLetra("HUD/Fonts/Small.BFT"), "any case");
+            t.IsFalse(f1::letra::esLetra(".bft"), "only the extension");
+            t.IsFalse(f1::letra::esLetra("Frontend/Textures/Btn.pct"), "a picture");
+            t.IsFalse(f1::letra::esLetra("Fonts/x.bft.bak"), "another extension");
+            t.IsFalse(f1::letra::esLetra(""), "empty");
+        });
+
+        tc.Run("the opened name from its string view register", [](TestCase &t)
+        {
+            std::vector<uint8_t> ram(kRam, 0xEEu);
+            const std::string nombre = "Frontend/Fonts/Futurah14Px.bft";
+            std::memcpy(ram.data() + 0x1230u, nombre.data(), nombre.size()); // not NUL-terminated: the length rules
+            t.Equals(f1::letra::nombreDeVista(ram.data(), kRam, vista(0x1230u, uint32_t(nombre.size()))), nombre,
+                     "address in the low word, length in the high word");
+            t.Equals(f1::letra::nombreDeVista(ram.data(), kRam, vista(0x1230u, 14u)), std::string("Frontend/Fonts"),
+                     "only the length");
+            ram[0x1230u + 8u] = 0u;
+            t.Equals(f1::letra::nombreDeVista(ram.data(), kRam, vista(0x1230u, uint32_t(nombre.size()))),
+                     std::string("Frontend"), "up to a NUL");
+            t.Equals(f1::letra::nombreDeVista(ram.data(), kRam, vista(0x80001230u, 8u)), std::string("Frontend"),
+                     "the address masked to the RAM");
+            t.IsTrue(f1::letra::nombreDeVista(ram.data(), kRam, vista(0x1230u, 0u)).empty(), "length 0");
+            t.IsTrue(f1::letra::nombreDeVista(ram.data(), kRam, vista(0x1230u, 256u)).empty(), "too long");
+            t.IsTrue(f1::letra::nombreDeVista(ram.data(), kRam, vista(kRam - 4u, 8u)).empty(), "past the end");
+            t.IsTrue(f1::letra::nombreDeVista(nullptr, kRam, vista(0x1230u, 8u)).empty(), "no RAM");
+        });
+
+        tc.Run("the capture: the font's stream reads, in order, until it closes", [](TestCase &t)
+        {
+            std::vector<uint8_t> ram(kRam, 0u);
+            for (size_t i = 0; i < kRam; ++i)
+                ram[i] = static_cast<uint8_t>(i * 7u);
+            f1::letra::Captura c;
+            c.abierto("Frontend/Fonts/Futurah14Px.bft", 0x500u);
+            t.IsFalse(c.activa || c.flujo != 0u, "before the reader is called: nothing followed");
+            c.empezar();
+            c.abierto("Frontend/Textures/Btn.pct", 0x400u);
+            t.Equals(c.flujo, 0u, "not a .bft: not followed");
+            c.abierto("Frontend/Fonts/Futurah14Px.bft", 0u);
+            t.Equals(c.flujo, 0u, "a failed open: not followed");
+            c.abierto("Frontend/Fonts/Futurah14Px.bft", 0x500u);
+            c.abierto("Frontend/Fonts/Futurah28Px.bft", 0x600u);
+            t.Equals(c.flujo, 0x500u, "the first .bft after the call");
+            t.Equals(c.nombre, std::string("Frontend/Fonts/Futurah14Px.bft"), "its name");
+
+            c.leer(ram.data(), kRam, 0x500u, 0x100u, 4u);
+            t.IsTrue(c.bytes.empty(), "a read is copied when the next one starts");
+            c.leer(ram.data(), kRam, 0x600u, 0x900u, 16u);
+            t.IsTrue(c.bytes.empty(), "another stream's read: ignored");
+            c.leer(ram.data(), kRam, 0x500u, 0x200u, 3u);
+            t.Equals(c.bytes.size(), size_t(4u), "the first read");
+            t.IsFalse(c.cerrar(ram.data(), kRam, 0x600u), "another stream's close: not the end");
+            t.IsTrue(c.cerrar(ram.data(), kRam, 0x500u), "the font's close: the end");
+            t.IsFalse(c.activa, "no longer following");
+            const std::vector<uint8_t> esperado = {ram[0x100], ram[0x101], ram[0x102], ram[0x103],
+                                                   ram[0x200], ram[0x201], ram[0x202]};
+            t.IsTrue(c.bytes == esperado, "both reads, in order (the last one at the close)");
+            t.IsFalse(c.cerrar(ram.data(), kRam, 0x500u), "closed once");
+            c.leer(ram.data(), kRam, 0x500u, 0x300u, 4u);
+            t.Equals(c.bytes.size(), size_t(7u), "reads after the close: ignored");
+
+            c.empezar();
+            t.IsTrue(c.activa && c.flujo == 0u && c.nombre.empty() && c.bytes.empty(), "the next call starts afresh");
+            c.abierto("HUD/Fonts/Small.bft", 0x700u);
+            c.leer(ram.data(), kRam, 0x700u, kRam - 2u, 4u);
+            t.IsTrue(c.cerrar(ram.data(), kRam, 0x700u), "closed");
+            t.IsTrue(c.bytes == std::vector<uint8_t>{ram[kRam - 2u], ram[kRam - 1u], ram[0], ram[1]},
+                     "a read wraps around the RAM (masked addresses)");
+            c.empezar();
+            c.abierto("HUD/Fonts/Small.bft", 0x700u);
+            c.leer(ram.data(), kRam, 0x700u, 0u, 0xFFFFFFFFu);
+            t.Equals(c.pendienteBytes, f1::letra::kLecturaMaxima, "a read is capped at 1 MB");
+        });
+    });
+}

+            t.IsTrue(contiene(f1::opciones_juego::kPaginaOpcionesPc, "vertical sync, FPS counter and screen mode."),
+                     "and in English");
+        });
+
         tc.Run("PC pages: DEFAULT VALUES on each value page, sliders for volume and vibration, list entries open 1, 3, 2",
                [](TestCase &t)

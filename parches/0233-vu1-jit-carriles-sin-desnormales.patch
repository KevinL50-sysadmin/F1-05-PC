+    // setup prepares the registers of every run (vi4 = 16 and vi6 = 0xFFFF are set after it) and check looks at them
+    // and at data afterwards. Returns the runs in which the MXCSR denormal flag (DE), read in the PATH1 callback, was
+    // set: whether any SSE instruction before the XGKICK saw a denormal operand. It first checks that the flag can be
+    // seen at all here (a denormal operand of an SSE add sets it: no DAZ), so a zero is not a blind pass.
+    uint32_t runDenormalLaneProbe(TestCase &t, const std::vector<std::array<uint32_t, 2>> &pairs, bool readFlags,
+                                  const std::function<void(VU1State &)> &setup,
+                                  const std::function<void(const VU1State &, const uint8_t *)> &check)
+    {
+        Vu1Fixture fx;
+        t.IsTrue(fx.initialize(), "VU1 fixture should initialize");
+        const unsigned int savedCsr = _mm_getcsr();
+        {
+            volatile uint32_t denormalBits = kProbeDenormal;
+            const uint32_t bits = denormalBits;
+            float denormal = 0.0f;
+            std::memcpy(&denormal, &bits, sizeof(denormal));
+            _mm_setcsr(savedCsr & ~0x3Fu);
+            volatile float sum = _mm_cvtss_f32(_mm_add_ss(_mm_set_ss(denormal), _mm_set_ss(denormal)));
+            (void)sum;
+            const bool seen = (_mm_getcsr() & 0x2u) != 0u;
+            _mm_setcsr(savedCsr);
+            t.IsTrue(seen, "a denormal SSE operand should set the MXCSR DE flag (the probe can see it)");
+        }
+        bool sawDenormal = false;
+        size_t packets = 0u;
+        fx.mem.setGifPacketCallback([&](const uint8_t *, uint32_t)
+        {
+            ++packets;
+            sawDenormal = sawDenormal || (_mm_getcsr() & 0x2u) != 0u;
+        });
+        const uint64_t tag = makeGifTag(1u, GIF_FMT_IMAGE, 0u, true);
+        std::memset(fx.code, 0, PS2_VU1_CODE_SIZE);
+        std::vector<std::array<uint32_t, 2>> program = pairs;
+        program.push_back({makeVuLowerSpecial(0x6Cu, 4u), kVuUpperNop});                     // XGKICK vi4
+        program.push_back({readFlags ? makeVuFlagRegister(0x1Au, 5u, 6u) : 0u, kVuUpperNop}); // FMAND vi5, vi6
+        program.push_back({0u, kVuUpperNop | 0x40000000u});                                  // E
+        program.push_back({0u, kVuUpperNop});
+        for (uint32_t i = 0; i < program.size(); ++i)

@@ -39,6 +39,32 @@ extern "C"
                                                              unsigned long length);
     __declspec(dllimport) int __stdcall SetProcessDefaultCpuSets(void *process, const unsigned long *ids,
                                                                  unsigned long count);
+    __declspec(dllimport) int __stdcall DuplicateHandle(void *sourceProcess, void *source, void *targetProcess,
+                                                        void **target, unsigned long access, int inherit,
+                                                        unsigned long options);
+    __declspec(dllimport) int __stdcall QueryThreadCycleTime(void *thread, unsigned long long *cycles);
+}
+
+namespace
+{
+    std::atomic<void *> s_eeThread{nullptr}; // real handle of the EE thread (patch 0224)
+}
+
+void ps2NoteEeThread()
+{
+    void *handle = nullptr;
+    if (DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &handle, 0u, 0,
+                        0x00000002u /* DUPLICATE_SAME_ACCESS */) != 0)
+        s_eeThread.store(handle, std::memory_order_release);
+}
+
+uint64_t ps2EeThreadCycles()
+{
+    void *handle = s_eeThread.load(std::memory_order_acquire);
+    unsigned long long cycles = 0u;
+    if (handle != nullptr)
+        QueryThreadCycleTime(handle, &cycles);
+    return cycles;
 }
 

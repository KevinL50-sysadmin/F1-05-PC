-        "PS2X_RUNNER_VERSION_STRING=\"${PS2Runtime_VERSION}\""
+        PS2X_RUNNER_VERSION_MAJOR=${PS2X_RUNNER_VERSION_MAJOR}
+        PS2X_RUNNER_VERSION_MINOR=${PS2X_RUNNER_VERSION_MINOR}
+        PS2X_RUNNER_VERSION_PATCH=${PS2X_RUNNER_VERSION_PATCH}
+        "PS2X_RUNNER_VERSION_STRING=\"${PS2X_RUNNER_VERSION_TEXTO}\""
     )
     if(EXISTS "${PS2X_RUNNER_ICON}")
         file(TO_CMAKE_PATH "${PS2X_RUNNER_ICON}" PS2X_RUNNER_ICON_PATH)

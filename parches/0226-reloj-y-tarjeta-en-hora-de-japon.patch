+                t.Equals(static_cast<int>(d->hour), 15, "file time hour should be UTC+9 (06 UTC -> 15 JST)");
+                t.Equals(static_cast<int>(d->min), 24, "file time minute (JST)");
+                t.Equals(static_cast<int>(d->sec), 28, "file time second (JST)");
+            }
+        });

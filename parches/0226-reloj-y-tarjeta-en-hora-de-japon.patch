+        // The PS2 real-time clock and the memory card's file times are in Japan time (UTC+9, no DST); games turn them
+        // into local time with the OSD time zone (sceScfGetLocalTimefromRTC). Host local time there showed saves
+        // (F1 05's profile list) 8 h early on a UTC+1 PC.
+        tc.Run("sceCdReadClock reports Japan time (UTC+9) like the PS2 RTC", [](TestCase &t)
+        {
+            TestContext test;
+            constexpr uint32_t clockAddr = GUEST_BUFFER_AREA_START + 0xA00;
+            auto fromBcd = [](uint8_t v) { return static_cast<int>((v >> 4) * 10 + (v & 0x0F)); };
+            auto expectedJst = [](std::time_t now)
+            {
+                const std::time_t jst = now + 9 * 3600;
+                std::tm tm{};
+                gmtime_s(&tm, &jst);
+                return tm;
+            };
+
+            const std::time_t before = std::time(nullptr);
+            clearContext(test.ctx);
+            setRegU32(test.ctx, 4, clockAddr);
+            ps2_stubs::sceCdReadClock(test.rdram.data(), &test.ctx, nullptr);
+            const std::time_t after = std::time(nullptr);
+            t.Equals(getRegS32(&test.ctx, 2), 1, "sceCdReadClock should succeed");
+
+            const uint8_t *c = test.rdram.data() + clockAddr;
+            bool matched = false;
+            for (std::time_t now = before; now <= after && !matched; ++now)
+            {
+                const std::tm e = expectedJst(now);
+                matched = fromBcd(c[1]) == e.tm_sec && fromBcd(c[2]) == e.tm_min && fromBcd(c[3]) == e.tm_hour &&
+                          fromBcd(c[5]) == e.tm_mday && fromBcd(c[6]) == e.tm_mon + 1 &&
+                          fromBcd(c[7]) == (e.tm_year + 1900) % 100;
+            }
+            const std::tm e = expectedJst(before);
+            t.IsTrue(matched, "sceCdReadClock should return UTC+9: got " + std::to_string(fromBcd(c[3])) + ":" +
+                                  std::to_string(fromBcd(c[2])) + " " + std::to_string(fromBcd(c[5])) + "/" +
+                                  std::to_string(fromBcd(c[6])) + ", expected " + std::to_string(e.tm_hour) + ":" +
+                                  std::to_string(e.tm_min) + " " + std::to_string(e.tm_mday) + "/" +
+                                  std::to_string(e.tm_mon + 1));
+            t.Equals(static_cast<int>(c[0]), 0, "sceCdReadClock should leave the status byte at 0");
+            t.Equals(static_cast<int>(c[4]), 0, "sceCdReadClock should leave the padding byte at 0");
+        });
+
+        tc.Run("sceMcGetDir reports file times in Japan time (UTC+9)", [](TestCase &t)
+        {

+            const auto *entry = reinterpret_cast<const SceMcTblGetDir *>(test.rdram.data() + GUEST_MC_TABLE_ADDR);
+            t.Equals(std::string(entry->entryName), std::string("game.dat"), "sceMcGetDir should return the file");

+            std::filesystem::create_directories(test.paths.mcRoot / "SAVEDATA");
+            const std::filesystem::path file = test.paths.mcRoot / "SAVEDATA" / "game.dat";
+            {
+                std::ofstream out(file, std::ios::binary);
+                out << "x";
+            }
+            // 2026-11-21 06:24:28.5 UTC = 2026-11-21 15:24:28 JST (half a second away from any rounding edge).
+            const auto sysTarget = std::chrono::system_clock::from_time_t(1795242268) + std::chrono::milliseconds(500);
+            std::filesystem::last_write_time(
+                file, std::chrono::time_point_cast<std::filesystem::file_time_type::duration>(
+                          std::filesystem::file_time_type::clock::now() + (sysTarget - std::chrono::system_clock::now())));
+
+            const uint32_t patternAddr = GUEST_STRING_AREA_START + 0x700;

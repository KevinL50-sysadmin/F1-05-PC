+    void schedulerPriorityRoundTrip(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        setRegU32(*ctx, 4, 0u);
+        setRegU32(*ctx, 5, 30u);
+        ChangeThreadPriority(rdram, ctx, runtime);
+        gPriorityFirstResult = getRegS32(*ctx, 2);
+        setRegU32(*ctx, 4, 0u);
+        setRegU32(*ctx, 5, static_cast<uint32_t>(gPriorityFirstResult));
+        ChangeThreadPriority(rdram, ctx, runtime);
+        gPrioritySecondResult = getRegS32(*ctx, 2);
+        const GuestThread *self = runtime->eeScheduler().thread(gSchedulerCreatedId);
+        gPriorityAfterRestore = self ? self->currentPriority : -1;
+        setRegU32(*ctx, 4, 0u);
+        setRegU32(*ctx, 5, 0u);
+        ChangeThreadPriority(rdram, ctx, runtime);
+        gPriorityInvalidResult = getRegS32(*ctx, 2);
+        gPriorityAfterInvalid = self ? self->currentPriority : -1;
+        ctx->pc = 0u;
+        runtime->requestStop();
+    }

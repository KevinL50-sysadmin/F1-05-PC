diff --git a/ps2xRuntime/include/ps2_game_identity.h b/ps2xRuntime/include/ps2_game_identity.h
new file mode 100644
index 0000000..7a3ec1d
--- /dev/null
+++ b/ps2xRuntime/include/ps2_game_identity.h
@@ -0,0 +1,36 @@
+#pragma once
+
+// Fase 3 (odd/tasks/identidad.md T1): the game's identity in one place. Every player-facing name, folder and disc
+// check of the runtime comes from here (Formula One 05, PAL, SCES-53033); the code was ported from F1 06, which had
+// these values spread over the files. The macros are for string literals built at compile time (L"..." texts,
+// printf formats, the opciones.ini and controles.ini templates); everything else uses the constants below.
+// Netplay (key salt, handshake magic, guest window) keeps its own values until phase 4.
+
+// The game's name in window titles, dialogs and messages.
+#define PS2X_GAME_TITLE "Formula One 05"
+// The short name in the comments of the files written for the player (opciones.ini, controles.ini).
+#define PS2X_GAME_SHORT_NAME "F1 05"
+// The player's folders (Documents\My Games\F1-05, LocalAppData\F1-05), the log and photo names.
+#define PS2X_GAME_FOLDER "F1-05"
+// The disc: PAL product code and the BOOT2 file of its SYSTEM.CNF ("BOOT2 = cdrom0:\SCES_530.33;1", VMODE = PAL).
+#define PS2X_GAME_SERIAL "SCES-53033"
+#define PS2X_GAME_BOOT_ELF "SCES_530.33"
+// The size of the data folder the disc is copied to, as told to the player (3.53 GB of files).
+#define PS2X_GAME_DATA_SIZE_ES "3,5 GB"
+#define PS2X_GAME_DATA_SIZE_EN "3.5 GB"
+
+namespace ps2x::identity
+{
+    inline constexpr const char *kTitle = PS2X_GAME_TITLE;
+    inline constexpr const char *kShortName = PS2X_GAME_SHORT_NAME;
+    inline constexpr const char *kFolder = PS2X_GAME_FOLDER;
+    inline constexpr const char *kSerial = PS2X_GAME_SERIAL;
+    inline constexpr const char *kBootElf = PS2X_GAME_BOOT_ELF;
+    // Written last into data (ps2_disc_setup.h kMarkerName) and the first text of the disc fingerprint.
+    inline constexpr const char *kMarkerName = PS2X_GAME_FOLDER "-disco.txt";
+    inline constexpr const char *kFingerprintSeed = PS2X_GAME_FOLDER "-disco\n";
+    // Photos: "<prefix>_<yyyy-mm-dd>_<hh-mm-ss>.png".
+    inline constexpr const char *kPhotoPrefix = PS2X_GAME_FOLDER;
+    // The log's name when the .exe's own name is unknown.
+    inline constexpr const char *kLogName = PS2X_GAME_FOLDER;
+}

+
+    // Patch 0222: a synthetic IRX (base 0x10000) that registers and enables a counting handler for IRQ 0x24, starts one
+    // channel-4 DMA of 1024 words (due 2048 cycles later) and then busy-waits ~12000 cycles in one of three contexts:
+    // in its start with interrupts enabled, in its start inside CpuSuspendIntr/CpuResumeIntr, or in a thbase alarm
+    // handler set 100 cycles ahead, or in the SPU2 IRQ 9 handler (core 0 ATTR bit 0x40 with the default IRQA in the
+    // output area; that handler acknowledges by clearing ATTR, then starts the DMA itself). At the end of the wait it stores the handler's call count at 0x10404, so the test
+    // sees whether the completion interrupt cut into that code.
+    // SuspendedSpu2Hit (no DMA): a counting IRQ 9 handler (acknowledges with ATTR = 0, count at 0x10418); inside
+    // CpuSuspendIntr the start sets core 0 ATTR = 0x40, busy-waits ~420000 cycles (the output-area hit falls in it),
+    // writes ATTR = 0x40 again (which reschedules the output IRQ) and stores the IRQ 9 count at 0x10404, then resumes.
+    // Patch 0222: the hit must be latched while masked and delivered after CpuResumeIntr, not lost.
+    struct SpuDmaMaskRig
+    {
+        enum class Wait
+        {
+            Enabled,
+            Suspended,
+            InAlarm,
+            InSpu2Irq,
+            SuspendedSpu2Hit
+        };
+        static constexpr uint32_t kHandlerCalls = 0x10400u;
+        static constexpr uint32_t kCallsSeenByWait = 0x10404u;
+        static constexpr uint32_t kSpu2HandlerCalls = 0x10418u;
+
+        iop_test::Host host;
+        ps2x::iop::IopSubsystem iop{host};
+
+        explicit SpuDmaMaskRig(Wait wait)
+        {
+            const auto jal = [](uint32_t target) { return 0x0C000000u | ((target >> 2u) & 0x03FFFFFFu); };
+            constexpr uint32_t kRegisterStub = 0x10114u; // intrman import table at 0x10100: 5 header words, then stubs
+            constexpr uint32_t kEnableStub = 0x1011Cu;
+            constexpr uint32_t kSuspendStub = 0x10124u;
+            constexpr uint32_t kResumeStub = 0x1012Cu;
+            constexpr uint32_t kSetAlarmStub = 0x10154u; // thbase import table at 0x10140
+            const uint32_t nop = 0u;
+            const std::vector<uint32_t> busyWait = {
+                0x340C0FA0u, 0x258CFFFFu, 0x1580FFFEu, nop,       // t4 = 4000; do t4-- while (t4 != 0)
+                0x3C0D0001u, 0x8DAE0400u, nop, 0xADAE0404u,       // [0x10404] = [0x10400]
+            };
+            std::vector<uint32_t> start = {
+                0x27BDFFE0u, 0xAFBF001Cu,                         // addiu sp, -32; sw ra, 28(sp)
+                0x24040024u, 0x24050001u, 0x3C060001u, 0x34C60200u, // RegisterIntrHandler(0x24, 1, 0x10200, 0)
+                0x00003821u, jal(kRegisterStub), nop,
+                0x24040024u, jal(kEnableStub), nop,               // EnableIntr(0x24)
+            };
+            const std::vector<uint32_t> dmaSetup = {
+                0x3C081F80u, 0x350810C0u,                         // t0 = 0x1F8010C0 (channel 4 MADR)
+                0x3C090001u, 0x35290600u, 0xAD090000u,            // MADR = 0x10600
+                0x3C090040u, 0x35290010u, 0xAD090004u,            // BCR = 64 blocks of 16 words
+                0x3C090100u, 0x35290201u,                         // t1 = 0x01000201 (CHCR start, to SPU2)
+            };
+            const auto append = [&start](const std::vector<uint32_t> &code) { start.insert(start.end(), code.begin(), code.end()); };
+            if (wait == Wait::SuspendedSpu2Hit)
+            {
+                append({0x24040009u, 0x24050001u, 0x3C060001u, 0x34C60340u, // RegisterIntrHandler(9, 1, 0x10340, 0)
+                        0x00003821u, jal(kRegisterStub), nop,
+                        0x24040009u, jal(kEnableStub), nop,                  // EnableIntr(9)
+                        0x3C040001u, 0x34840408u, jal(kSuspendStub), nop,    // CpuSuspendIntr(0x10408)
+                        0x3C0E1F90u, 0x340F0040u, 0xA5CF019Au,               // core 0 ATTR = 0x40 (IRQ enable)
+                        0x3C0C0002u, 0x358C22E0u,                            // t4 = 140000
+                        0x258CFFFFu, 0x1580FFFEu, nop,                       // do t4-- while (t4 != 0)
+                        0xA5CF019Au,                                         // ATTR = 0x40 again
+                        0x3C0D0001u, 0x8DAE0418u, nop, 0xADAE0404u,          // [0x10404] = [0x10418]
+                        0x8DA40408u, nop, jal(kResumeStub), nop,             // CpuResumeIntr([0x10408])
+                        0x8FBF001Cu, 0x00001021u, 0x27BD0020u, 0x03E00008u, nop}); // return 0
+            }
+            else if (wait == Wait::InSpu2Irq)
+            {
+                append({0x24040009u, 0x24050001u, 0x3C060001u, 0x34C602C0u, // RegisterIntrHandler(9, 1, 0x102C0, 0)
+                        0x00003821u, jal(kRegisterStub), nop,
+                        0x24040009u, jal(kEnableStub), nop,                  // EnableIntr(9)
+                        0x3C0E1F90u, 0x340F0040u, 0xA5CF019Au});             // core 0 ATTR = 0x40 (IRQ enable)
+                append({0x8FBF001Cu, 0x00001021u, 0x27BD0020u, 0x03E00008u, nop}); // return 0
+            }
+            else

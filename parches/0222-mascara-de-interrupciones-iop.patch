+            if (wait == Wait::Suspended)
+                append({0x3C040001u, 0x34840408u, jal(kSuspendStub), nop}); // CpuSuspendIntr(0x10408)
+            // The IRQ 9 starts have already returned (InSpu2Irq: its handler starts the DMA).
+            if (wait != Wait::InSpu2Irq && wait != Wait::SuspendedSpu2Hit)
+            {
+                append({0xAD090008u});                                     // start the DMA
+                if (wait == Wait::InAlarm)
+                    append({0x3C040001u, 0x34840410u, 0x3C050001u, 0x34A50240u, // SetAlarm(0x10410, 0x10240, 0)
+                            0x00003021u, jal(kSetAlarmStub), nop});
+                else
+                    append(busyWait);
+                if (wait == Wait::Suspended)
+                    append({0x8DA40408u, nop, jal(kResumeStub), nop});      // CpuResumeIntr([0x10408])
+                append({0x8FBF001Cu, 0x00001021u, 0x27BD0020u, 0x03E00008u, nop}); // return 0
+            }
+
+            iop_test::Irx image(0x10000u, 0x800u);
+            for (size_t i = 0; i < start.size(); ++i)
+                image.words(static_cast<uint32_t>(i * 4u), {start[i]});
+            image.words(0x100u, {0x41E00000u, 0u, 0x0101u, 0x72746E69u, 0x006E616Du, // "intrman"
+                                 0x03E00008u, 0x24000004u,                          // RegisterIntrHandler
+                                 0x03E00008u, 0x24000006u,                          // EnableIntr
+                                 0x03E00008u, 0x24000011u,                          // CpuSuspendIntr
+                                 0x03E00008u, 0x24000012u,                          // CpuResumeIntr
+                                 0u, 0u});
+            image.words(0x140u, {0x41E00000u, 0u, 0x0101u, 0x61626874u, 0x00006573u, // "thbase"
+                                 0x03E00008u, 0x24000023u,                          // SetAlarm
+                                 0u, 0u});
+            image.words(0x200u, {
+                0x3C080001u, 0x8D090400u, nop,                    // calls + 1
+                0x25290001u, 0xAD090400u,
+                0x24020001u, 0x03E00008u, nop,                    // return 1
+            });
+            for (size_t i = 0; i < busyWait.size(); ++i)          // alarm handler: the wait, then return 0 (no rearm)
+                image.words(0x240u + static_cast<uint32_t>(i * 4u), {busyWait[i]});
+            image.words(0x240u + static_cast<uint32_t>(busyWait.size() * 4u), {0x00001021u, 0x03E00008u, nop});
+            std::vector<uint32_t> spu2Handler = {0x3C0E1F90u, 0xA5C0019Au}; // IRQ 9: ATTR = 0 (acknowledge)

+                0x3C081F90u, 0xA500019Au,                         // ATTR = 0 (acknowledge)
+                0x3C080001u, 0x8D090418u, nop,                    // IRQ 9 calls + 1
+                0x25290001u, 0xAD090418u,
+                0x24020001u, 0x03E00008u, nop,                    // return 1
+            });
+            image.words(0x404u, {0xFFFFFFFFu});                   // stays so if the wait never ran
+            image.words(0x410u, {100u, 0u});                      // alarm clock: 100 cycles
